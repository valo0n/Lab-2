PORT=5000
NODE_ENV=development

# MySQL (Prisma)
DATABASE_URL="mysql://root:your_password@localhost:3306/clicon_ecommerce"

# MongoDB
MONGODB_URI=mongodb://localhost:27017/clicon_ecommerce

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_this
JWT_REFRESH_SECRET=your_refresh_secret_change_this
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CORS
CLIENT_URL=http://localhost:5173

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
